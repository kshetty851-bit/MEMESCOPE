# MEMESCOPE — production environment template.
#
#   cp .env.production.example .env.production   and fill in every REQUIRED value.
#
# .env.production is gitignored and must never be committed. Secrets belong in
# the deployment host's own store; this file documents their shape, not their
# values.
#
# The application refuses to boot in production if ALLOWED_HOSTS is "*", if the
# refresh cookie is not secure, or if DEVELOPMENT_BYPASS_AUTH is set. Those are
# validated in backend/app/core/config.py — a misconfigured process fails loudly
# at startup rather than serving something subtly wrong.

# --- Identity ----------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# --- REQUIRED: the public domain ---------------------------------------------
# Caddy requests a certificate for exactly this name. It must already resolve to
# this host or the ACME challenge fails and nothing is served over HTTPS.
DOMAIN=memescope.example.com
ACME_EMAIL=ops@example.com

# --- REQUIRED: secrets --------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- REQUIRED: network boundaries ---------------------------------------------
# Both must be explicit — "*" is rejected in production.
ALLOWED_HOSTS=memescope.example.com
CORS_ORIGINS=https://memescope.example.com

# Peers whose X-Forwarded-For may be believed. Left unset, the rate limiter keys
# every user onto Caddy's address and they share one allowance. The default is
# the Docker bridge range, which is correct when Caddy is the only front door.
TRUSTED_PROXY_IPS=172.16.0.0/12

# --- Database and cache -------------------------------------------------------
POSTGRES_USER=memescope
POSTGRES_DB=memescope

# --- Frontend build args ------------------------------------------------------
# Inlined at build time, so changing these needs a rebuild, not a restart.
NEXT_PUBLIC_API_URL=https://memescope.example.com

# --- Cookies ------------------------------------------------------------------
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# --- Feature flags ------------------------------------------------------------
# The pipeline is off unless explicitly enabled. Scanner requires HELIUS_API_KEY;
# scoring requires enrichment.
FEATURE_SCANNER_ENABLED=true
FEATURE_ENRICHMENT_ENABLED=true
FEATURE_AI_SCORING_ENABLED=true
# Opportunity Radar: re-evaluates existing projects for strengthening signals.
FEATURE_RADAR_ENABLED=true
RADAR_SWEEP_BATCH_LIMIT=500
FEATURE_PUMPFUN_RADAR_ENABLED=true
PUMPFUN_RADAR_MIN_AGE_DAYS=6
PUMPFUN_RADAR_MAX_AGE_DAYS=8
PUMPFUN_RADAR_MIN_MARKET_CAP=0
PUMPFUN_RADAR_MIN_LIQUIDITY=0
PUMPFUN_RADAR_BATCH_LIMIT=500
SCORING_MODEL_VERSION=v1

# --- Pipeline health ------------------------------------------------------------
# Per-stage staleness thresholds in minutes: healthy below the first, degraded
# between the two, down at or past the second. GET /api/v1/health/pipeline reports
# them and returns 503 when the roll-up is down; the scanner's container
# healthcheck uses the scanner pair to decide whether to restart the service.
HEALTH_SCANNER_DEGRADED_MINUTES=15
HEALTH_SCANNER_DOWN_MINUTES=60
HEALTH_ENRICHMENT_DEGRADED_MINUTES=10
HEALTH_ENRICHMENT_DOWN_MINUTES=30
HEALTH_SCORING_DEGRADED_MINUTES=30
HEALTH_SCORING_DOWN_MINUTES=120
HEALTH_RADAR_DEGRADED_MINUTES=30
HEALTH_RADAR_DOWN_MINUTES=120
# Consecutive failed Helius reconnects before the scanner logs ERROR and reports
# itself degraded, then how often it repeats that ERROR.
SCANNER_RECONNECT_ERROR_ATTEMPTS=5
SCANNER_RECONNECT_ERROR_EVERY=20
SCANNER_STATE_TTL_SECONDS=300

# Never set in production — the application refuses to boot with it on.
DEVELOPMENT_BYPASS_AUTH=false

# --- External services ---------------------------------------------------------
HELIUS_API_KEY=

# --- Observability (optional) --------------------------------------------------
# Leave blank to disable. Nothing is initialised without a DSN, so an empty
# value is a supported configuration rather than a broken one.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Alpha ---------------------------------------------------------------------
# Where the feedback button sends testers. Blank hides the button rather than
# rendering a control that goes nowhere.
FEEDBACK_URL=

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Backups -------------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
