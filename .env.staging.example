# MEMESCOPE — staging environment template.
#
#   cp .env.staging.example .env.staging   and fill in every REQUIRED value.
#
# Staging mirrors production so that a deploy rehearsal is a real rehearsal.
# Two deliberate differences: traces are sampled at 100% because the volume is
# low and the point is to see everything, and this environment is where a
# migration is proved before it touches production data.
#
# .env.staging is gitignored and must never be committed. Secrets belong in
# the deployment host's own store; this file documents their shape, not their
# values.
#
# The application refuses to boot in production if ALLOWED_HOSTS is "*", if the
# refresh cookie is not secure, or if DEVELOPMENT_BYPASS_AUTH is set. Those are
# validated in backend/app/core/config.py — a misconfigured process fails loudly
# at startup rather than serving something subtly wrong.

# --- Identity ----------------------------------------------------------------
ENVIRONMENT=staging
DEBUG=false

# --- REQUIRED: the public domain ---------------------------------------------
# Caddy requests a certificate for exactly this name. It must already resolve to
# this host or the ACME challenge fails and nothing is served over HTTPS.
DOMAIN=staging.memescope.example.com
ACME_EMAIL=ops@example.com

# --- REQUIRED: secrets --------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- REQUIRED: network boundaries ---------------------------------------------
# Both must be explicit — "*" is rejected in production.
ALLOWED_HOSTS=staging.memescope.example.com
CORS_ORIGINS=https://staging.memescope.example.com

# Peers whose X-Forwarded-For may be believed. Left unset, the rate limiter keys
# every user onto Caddy's address and they share one allowance. The default is
# the Docker bridge range, which is correct when Caddy is the only front door.
TRUSTED_PROXY_IPS=172.16.0.0/12

# --- Database and cache -------------------------------------------------------
POSTGRES_USER=memescope
POSTGRES_DB=memescope

# --- Frontend build args ------------------------------------------------------
# Inlined at build time, so changing these needs a rebuild, not a restart.
NEXT_PUBLIC_API_URL=https://staging.memescope.example.com

# --- Cookies ------------------------------------------------------------------
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax

# --- Feature flags ------------------------------------------------------------
# The pipeline is off unless explicitly enabled. Scanner requires HELIUS_API_KEY;
# scoring requires enrichment.
FEATURE_SCANNER_ENABLED=true
YELLOWSTONE_ENABLED=false
YELLOWSTONE_SHADOW_MODE=true
YELLOWSTONE_GRPC_URL=
YELLOWSTONE_X_TOKEN=
FEATURE_ENRICHMENT_ENABLED=true
FEATURE_AI_SCORING_ENABLED=true
# Opportunity Radar: re-evaluates existing projects for strengthening signals.
FEATURE_RADAR_ENABLED=true
RADAR_SWEEP_BATCH_LIMIT=500
FEATURE_PUMPFUN_RADAR_ENABLED=true
PUMPFUN_RADAR_MIN_AGE_DAYS=6
PUMPFUN_RADAR_MAX_AGE_DAYS=8
PUMPFUN_RADAR_MIN_MARKET_CAP=0
PUMPFUN_RADAR_MIN_LIQUIDITY=0
PUMPFUN_RADAR_BATCH_LIMIT=500
SCORING_MODEL_VERSION=v1

# --- Opportunity Engine --------------------------------------------------------
# The signal detection layer. Off by default: while off nothing runs and no
# existing behaviour changes. Detection is event-driven — it rides enrichment
# writes, so there is no recurring scan to schedule.
# Which trading venues count as a bonding curve, and which as a graduated pool.
# A launchpad renaming its venue is a config change, not a code change.
# Observations a signal needs before it may become ACTIVE. One snapshot is noise.
# Per-signal-type TTL. A token that graduated three days ago did not graduate now.
# Grace before an expiring opportunity closes, and settling before archival frees
# the token to open a new generation.

# --- Near Graduation provider ---------------------------------------------------
# Off because the data does not support it, not because the provider is
# unfinished. `market_cap` on a pump.fun bonding-curve pair does not track curve
# progress: across 386 observed graduations it identified 5, and of 48 tokens
# that reached $50k only those same 5 graduated. Enable once a real source of
# curve progress exists — on-chain reserves via Helius is the route ADR 0002
# names — and the signal reaches the board with no code change.

# --- Bonding curve collection ---------------------------------------------------
# Reads pump.fun curve accounts directly from the chain via getMultipleAccounts.
# This is the input ARCHITECTURE_DECISIONS.md §14a names as the unblock for Near
# Graduation. Off by default, and additionally blocked today by the Helius plan
# quota — every RPC method returns `429 max usage reached`.
FEATURE_CURVE_COLLECTION_ENABLED=false
CURVE_COLLECTION_BATCH_LIMIT=100

# --- Pipeline health ------------------------------------------------------------
# Per-stage staleness thresholds in minutes: healthy below the first, degraded
# between the two, down at or past the second. GET /api/v1/health/pipeline reports
# them and returns 503 when the roll-up is down; the scanner's container
# healthcheck uses the scanner pair to decide whether to restart the service.
HEALTH_SCANNER_DEGRADED_MINUTES=15
HEALTH_SCANNER_DOWN_MINUTES=60
HEALTH_ENRICHMENT_DEGRADED_MINUTES=10
HEALTH_ENRICHMENT_DOWN_MINUTES=30
HEALTH_SCORING_DEGRADED_MINUTES=30
HEALTH_SCORING_DOWN_MINUTES=120
HEALTH_RADAR_DEGRADED_MINUTES=30
HEALTH_RADAR_DOWN_MINUTES=120
# Consecutive failed Helius reconnects before the scanner logs ERROR and reports
# itself degraded, then how often it repeats that ERROR.
SCANNER_RECONNECT_ERROR_ATTEMPTS=5
SCANNER_RECONNECT_ERROR_EVERY=20
SCANNER_STATE_TTL_SECONDS=300

# Never set in production — the application refuses to boot with it on.
DEVELOPMENT_BYPASS_AUTH=false

# --- External services ---------------------------------------------------------
HELIUS_API_KEY=

# --- Real wallet: observation-only in Phase 1 --------------------------------
# Separate from scanner RPC settings. Do not configure a signer path here.
REAL_WALLET_NETWORK=devnet
REAL_WALLET_RPC_URL=https://api.devnet.solana.com
REAL_WALLET_PUBLIC_KEY=
REAL_WALLET_EXECUTION_SECRET_FILE=
REAL_WALLET_EXECUTION_MODE=disabled
REAL_WALLET_EXECUTION_ENABLED=false
REAL_WALLET_AUTOTRADE_ENABLED=false
# Leave blank until an isolated devnet signer sidecar is intentionally started.
PHASE2_DEVNET_SIGNER_SOCKET=
PHASE2_DEVNET_QUOTE_TTL_SECONDS=60
PHASE2_DEVNET_APPROVAL_TTL_SECONDS=120
PHASE2_DEVNET_MAX_TRANSFER_LAMPORTS=1000000
PHASE2_DEVNET_CONFIRM_RETRIES=6
PHASE2_DEVNET_CONFIRM_RETRY_SECONDS=1

# --- Observability (optional) --------------------------------------------------
# Leave blank to disable. Nothing is initialised without a DSN, so an empty
# value is a supported configuration rather than a broken one.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Alpha ---------------------------------------------------------------------
# Where the feedback button sends testers. Blank hides the button rather than
# rendering a control that goes nowhere.
FEEDBACK_URL=

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Backups -------------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
