FROM python:3.12-slim
WORKDIR /lab
COPY pyproject.toml README.md ./
RUN python -c "import tomllib, subprocess; subprocess.check_call(['pip','install','--no-cache-dir'] + tomllib.load(open('pyproject.toml','rb'))['project']['dependencies'] + ['psycopg[binary]==3.2.10'])"
COPY src ./src
RUN pip install --no-cache-dir --no-deps .
RUN useradd --uid 10001 --create-home lab && mkdir /data && chown lab /data
USER lab
EXPOSE 8011
CMD ["python", "-m", "memescope_pretrade_ai.service"]
