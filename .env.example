# Copy to .env and fill in. Never commit .env.
# Generate a secret:  openssl rand -base64 48

# --- Application -------------------------------------------------------------
ENVIRONMENT=local              # local | test | staging | production
DEBUG=true
SECRET_KEY=replace-me-with-openssl-rand-base64-48
LOG_LEVEL=INFO
LOG_FORMAT=console             # console locally, json when deployed

# --- Ports (host side) -------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Database ----------------------------------------------------------------
POSTGRES_USER=memescope
POSTGRES_PASSWORD=memescope
POSTGRES_DB=memescope

# --- Cache -------------------------------------------------------------------
# Required in production; leave blank locally.
REDIS_PASSWORD=

# --- Auth --------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=false    # must be true in production

# --- Temporary Alpha Access --------------------------------------------------
# Server-validated private-alpha gate. The code is intentionally not shipped to
# frontend JavaScript. Keep ALPHA_ACCESS_REQUIRED=false for local development.
ALPHA_ACCESS_CODE=619554
ALPHA_ACCESS_REQUIRED=false
ALPHA_ACCESS_COOKIE_SECURE=false
ALPHA_ACCESS_COOKIE_SAMESITE=lax
ALPHA_ACCESS_SESSION_DAYS=30

# --- CORS / hosts ------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*                # must be an explicit list in production

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend (inlined at build time) ----------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=MemeScope AI
NEXT_PUBLIC_ENVIRONMENT=local

# --- Observability (optional) ------------------------------------------------
SENTRY_DSN=

# --- Solana / Helius ---------------------------------------------------------
# Required when FEATURE_SCANNER_ENABLED=true. Get one at https://helius.dev
SOLANA_RPC_PROVIDER=helius
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
HELIUS_API_KEY=
HELIUS_RPC_BASE=https://mainnet.helius-rpc.com
HELIUS_WS_BASE=wss://mainnet.helius-rpc.com

# --- Token discovery scanner --------------------------------------------------
# Comma-separated program ids whose logs are watched for token creation.
# Default is the pump.fun program, where most Solana meme coins launch.
SCANNER_WATCH_PROGRAMS=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
SCANNER_COMMITMENT=confirmed
SCANNER_QUEUE_SIZE=2000
SCANNER_WORKER_CONCURRENCY=4
SCANNER_BACKOFF_INITIAL_SECONDS=1.0
SCANNER_BACKOFF_MAX_SECONDS=60.0
SCANNER_TX_FETCH_ATTEMPTS=6
SCANNER_METADATA_ATTEMPTS=5
SCANNER_DEDUPE_TTL_SECONDS=3600
# Reconnect escalation. Below the first threshold a failed reconnect is logged
# at WARNING and treated as transient. At or past it the scanner logs ERROR and
# reports itself degraded through /api/v1/health/pipeline, then repeats the
# ERROR only every Nth attempt so a long outage stays readable.
SCANNER_RECONNECT_ERROR_ATTEMPTS=5
SCANNER_RECONNECT_ERROR_EVERY=20
# How long the scanner's published connection state stays valid in Redis.
SCANNER_STATE_TTL_SECONDS=300

# --- Yellowstone gRPC shadow discovery ---------------------------------------
# Phase 1 is observational only. Keep disabled until provider credentials are
# supplied out of band; it never replaces the standard RPC scanner.
YELLOWSTONE_ENABLED=false
YELLOWSTONE_SHADOW_MODE=true
YELLOWSTONE_GRPC_URL=
YELLOWSTONE_X_TOKEN=
YELLOWSTONE_PROGRAM_IDS=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
YELLOWSTONE_REPLAY_OVERLAP_SLOTS=2
YELLOWSTONE_MAX_RECEIVE_BYTES=16777216

# --- Pipeline health ----------------------------------------------------------
# Per-stage staleness thresholds in minutes: healthy below the first, degraded
# between the two, down at or past the second. Read by GET /api/v1/health/pipeline
# and by the scanner's container healthcheck.
HEALTH_SCANNER_DEGRADED_MINUTES=15
HEALTH_SCANNER_DOWN_MINUTES=60
HEALTH_ENRICHMENT_DEGRADED_MINUTES=10
HEALTH_ENRICHMENT_DOWN_MINUTES=30
HEALTH_SCORING_DEGRADED_MINUTES=30
HEALTH_SCORING_DOWN_MINUTES=120
HEALTH_RADAR_DEGRADED_MINUTES=30
HEALTH_RADAR_DOWN_MINUTES=120

# --- Market data provider -----------------------------------------------------
# Which MarketDataProvider implementation to use. See
# docs/adr/0001-market-provider-abstraction.md for why this is swappable.
MARKET_PROVIDER=dexscreener
MARKET_PROVIDER_BASE_URL=https://api.dexscreener.com
# DexScreener needs no key; other providers may.
MARKET_PROVIDER_API_KEY=
MARKET_PROVIDER_TIMEOUT_SECONDS=10
MARKET_PROVIDER_BATCH_SIZE=30
MARKET_PROVIDER_MAX_ATTEMPTS=3

# Secondary provider — fills the pump.fun bonding-curve liquidity gap.
# Set MARKET_PROVIDER=composite to enable it. DexScreener reports no liquidity
# for bonding-curve pools, which is ~97% of new tokens and the reason most of
# the feed scores at 45% coverage rather than the model's 65% ceiling.
# Free tier is ~30 calls/min; 25 leaves headroom before the breaker trips.
MARKET_SECONDARY_BASE_URL=https://api.geckoterminal.com/api/v2
MARKET_SECONDARY_NETWORK=solana
MARKET_SECONDARY_BATCH_SIZE=30
MARKET_SECONDARY_MAX_ATTEMPTS=2
MARKET_SECONDARY_CALLS_PER_MINUTE=25

# --- Circuit breaker ----------------------------------------------------------
MARKET_BREAKER_FAILURE_THRESHOLD=5
MARKET_BREAKER_RESET_SECONDS=60
MARKET_BREAKER_HALF_OPEN_SUCCESSES=2

# --- Market enrichment worker -------------------------------------------------
ENRICHMENT_POLL_INTERVAL_SECONDS=5
ENRICHMENT_BATCH_LIMIT=60
ENRICHMENT_CONCURRENCY=4
ENRICHMENT_DEAD_LETTER_THRESHOLD=10

# Adaptive refresh tiers: token age (minutes) -> refresh interval (seconds).
ENRICHMENT_TIER_FRESH_MAX_MINUTES=30
ENRICHMENT_TIER_FRESH_INTERVAL_SECONDS=30
ENRICHMENT_TIER_YOUNG_MAX_MINUTES=360
ENRICHMENT_TIER_YOUNG_INTERVAL_SECONDS=300
ENRICHMENT_TIER_MATURE_MAX_MINUTES=1440
ENRICHMENT_TIER_MATURE_INTERVAL_SECONDS=1800
ENRICHMENT_TIER_OLD_INTERVAL_SECONDS=21600

# --- Browser live-update invalidations --------------------------------------
# Redis topic shared by API and workers. This is not a second event bus.
LIVE_EVENT_CHANNEL=memescope:live:changed

# --- Feature flags -----------------------------------------------------------
# Turn on to run the discovery scanner (requires HELIUS_API_KEY).
FEATURE_SCANNER_ENABLED=false
# Turn on to run the market enrichment worker.
FEATURE_ENRICHMENT_ENABLED=false
# Turn on to score enriched tokens. Requires FEATURE_ENRICHMENT_ENABLED, since
# scoring runs off the snapshots enrichment writes.
FEATURE_AI_SCORING_ENABLED=false
# Opportunity Radar: re-evaluates existing projects for strengthening signals.
FEATURE_RADAR_ENABLED=false
FEATURE_RADAR_QUALITY_DATASET=true
# Keep every selected Radar evaluation plus all near-admission candidates and a
# deterministic 1/N control sample of other non-selected evaluations.
RADAR_QUALITY_CONTROL_SAMPLE_MODULUS=20
RADAR_QUALITY_OUTCOME_BATCH_LIMIT=100
RADAR_SWEEP_BATCH_LIMIT=500
# Discovery-only Pump.fun Radar admission. This does not enable technical,
# community, or AI scoring; it reuses discovered tokens and market snapshots.
FEATURE_PUMPFUN_RADAR_ENABLED=false
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
PUMPFUN_RADAR_MIN_AGE_DAYS=6
PUMPFUN_RADAR_MAX_AGE_DAYS=8
PUMPFUN_RADAR_MIN_MARKET_CAP=0
PUMPFUN_RADAR_MIN_LIQUIDITY=0
PUMPFUN_RADAR_BATCH_LIMIT=500
# Which weight vector to score with. An unknown version fails at startup rather
# than silently falling back.
SCORING_MODEL_VERSION=v1

# --- Paper Wallet ------------------------------------------------------------
# Jupiter mode captures a quote at future paper entry/exit decisions and stores
# it with the trade. Legacy mode keeps the deterministic pre-Sprint-39 cost
# estimate. Historical rows are never rewritten by changing this value.
FEATURE_PAPER_WALLET_ENABLED=false
PAPER_EXECUTION_MODEL=jupiter
JUPITER_QUOTE_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_QUOTE_TIMEOUT_SECONDS=6
JUPITER_QUOTE_SLIPPAGE_BPS=50

# --- Dedicated real execution wallet (future use; safe defaults) -----------
# PUBLIC address only. Do not put any private key, seed phrase, or JSON keypair
# in this file. In a future live deployment, mount the JSON keypair file into
# the backend container and set its in-container path below.
REAL_WALLET_EXECUTION_MODE=disabled
REAL_WALLET_EXECUTION_ENABLED=false
REAL_WALLET_AUTOTRADE_ENABLED=false
# Wallet reads use an explicit cluster and do not inherit scanner RPC settings.
# Keep DEVNET until a separately reviewed mainnet observation change.
REAL_WALLET_NETWORK=devnet
REAL_WALLET_RPC_URL=https://api.devnet.solana.com
REAL_WALLET_PUBLIC_KEY=
REAL_WALLET_EXECUTION_SECRET_FILE=
# Phase 2 manual verification. Keep the socket blank unless the separately
# mounted `devnet-signer` profile is intentionally started. Never put the
# signer path or key bytes into this file; it belongs only to that process.
PHASE2_DEVNET_SIGNER_SOCKET=
PHASE2_DEVNET_QUOTE_TTL_SECONDS=60
PHASE2_DEVNET_APPROVAL_TTL_SECONDS=120
PHASE2_DEVNET_MAX_TRANSFER_LAMPORTS=1000000
PHASE2_DEVNET_CONFIRM_RETRIES=6
PHASE2_DEVNET_CONFIRM_RETRY_SECONDS=1
# Hosts a wallet RPC may be pointed at. Empty permits nothing. A genesis check
# proves which chain an endpoint *claims*; this proves which endpoint we agreed
# to ask. Add the mainnet host here only alongside REAL_WALLET_NETWORK=mainnet.
REAL_WALLET_ALLOWED_RPC_HOSTS=api.devnet.solana.com
# Extra top-level programs a real swap may invoke, beyond the reviewed defaults
# in real_wallet/tx_inspect.py. Widen only after decoding a real order.
REAL_WALLET_ALLOWED_PROGRAM_IDS=
# What one real entry spends. ZERO MEANS UNCONFIGURED, AND UNCONFIGURED
# REFUSES. The final $100/$50/$25 ladder is the Paper position-size evidence
# work's decision; it is deliberately not defaulted here. Must be <= MAX_TRADE.
REAL_WALLET_ENTRY_SIZE_USD=0
REAL_WALLET_MAX_TRADE_USD=5
REAL_WALLET_MAX_OPEN_POSITIONS=1
REAL_WALLET_MAX_TOTAL_EXPOSURE_USD=10
REAL_WALLET_MAX_DAILY_NOTIONAL_USD=20
REAL_WALLET_MAX_DAILY_LOSS_USD=10
# Canary bounds. Both are hard ceilings, not targets.
REAL_WALLET_MAX_DAILY_TRADES=4
REAL_WALLET_MAX_BALANCE_SOL=0.25
# Real exit quote bounds. A fired trigger with no priceable route is reported
# as an explicit failure state, never retried away.
REAL_WALLET_EXIT_MAX_QUOTE_AGE_SECONDS=15
REAL_WALLET_EXIT_MAX_PRICE_IMPACT_PCT=5
REAL_WALLET_EXIT_MAX_SLIPPAGE_BPS=300
REAL_WALLET_MIN_SOL_FEE_RESERVE=0.01
REAL_WALLET_AUTOTRADE_COOLDOWN_SECONDS=300
REAL_WALLET_MAX_CONSECUTIVE_EXECUTION_FAILURES=2
REAL_WALLET_DRY_RUN_CANDIDATE_LIMIT=10
FEATURE_REAL_WALLET_DRY_RUN_ENABLED=false
# Safety-gate thresholds. Comma-separated lists are accepted for the two
# allowlists; narrowing them is safe, widening them is a policy change.
REAL_WALLET_SAFETY_POLICY_VERSION=real_wallet_safety_v1
REAL_WALLET_SAFETY_MAX_MARKET_AGE_SECONDS=90
REAL_WALLET_SAFETY_MAX_QUOTE_AGE_SECONDS=15
REAL_WALLET_SAFETY_MAX_BUY_PRICE_IMPACT_PCT=5
REAL_WALLET_SAFETY_MAX_SELL_PRICE_IMPACT_PCT=5
REAL_WALLET_SAFETY_MAX_ROUND_TRIP_LOSS_PCT=10
REAL_WALLET_SAFETY_MAX_POSITION_LIQUIDITY_RATIO=0.01
REAL_WALLET_SAFETY_MAX_PRICE_DEVIATION_PCT=5
REAL_WALLET_SAFETY_SUPPORTED_VENUES=pumpfun,pumpswap
REAL_WALLET_SAFETY_SUPPORTED_TOKEN_2022_EXTENSIONS=18,19
JUPITER_V2_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_V2_ORDER_TIMEOUT_SECONDS=8
JUPITER_API_KEY=
# --- Execution fee accounting ---------------------------------------------
# SOL/USD is required to convert network fees into the USD every limit is
# written in, and to decide whether the wallet can still afford its own exit.
EXECUTION_SOL_PRICE_PROVIDER=jupiter
EXECUTION_SOL_PRICE_MAX_AGE_SECONDS=120
EXECUTION_SOL_MINT=So11111111111111111111111111111111111111112
EXECUTION_PRIORITY_FEE_SOL=0.0005
EXECUTION_EXIT_FEE_RESERVE_MULTIPLIER=2
JUPITER_V2_ORDER_TIMEOUT_SECONDS=8

# --- Opportunity Engine --------------------------------------------------------
# The signal detection layer. Off by default: while off nothing runs and no
# existing behaviour changes. Detection is event-driven — it rides enrichment
# writes, so there is no recurring scan to schedule.
FEATURE_OPPORTUNITY_ENGINE_ENABLED=false
# Which trading venues count as a bonding curve, and which as a graduated pool.
# A launchpad renaming its venue is a config change, not a code change.
OPPORTUNITY_BONDING_CURVE_VENUES=pumpfun
OPPORTUNITY_GRADUATED_VENUES=pumpswap
# Observations a signal needs before it may become ACTIVE. One snapshot is noise.
OPPORTUNITY_REQUIRED_CONFIRMATIONS=2
# Per-signal-type TTL. A token that graduated three days ago did not graduate now.
OPPORTUNITY_TTL_FRESH_GRADUATION_SECONDS=172800
# Grace before an expiring opportunity closes, and settling before archival frees
# the token to open a new generation.
OPPORTUNITY_GRACE_SECONDS=3600
OPPORTUNITY_ARCHIVE_AFTER_SECONDS=86400

# --- Near Graduation provider ---------------------------------------------------
# Off because the data does not support it, not because the provider is
# unfinished. `market_cap` on a pump.fun bonding-curve pair does not track curve
# progress: across 386 observed graduations it identified 5, and of 48 tokens
# that reached $50k only those same 5 graduated. Enable once a real source of
# curve progress exists — on-chain reserves via Helius is the route ADR 0002
# names — and the signal reaches the board with no code change.
OPPORTUNITY_NEAR_GRADUATION_ENABLED=false
OPPORTUNITY_GRADUATION_MARKET_CAP=69000
OPPORTUNITY_NEAR_GRADUATION_MIN_PROGRESS=0.55

# --- Bonding curve collection ---------------------------------------------------
# Reads pump.fun curve accounts directly from the chain via getMultipleAccounts.
# This is the input ARCHITECTURE_DECISIONS.md §14a names as the unblock for Near
# Graduation. Off by default, and additionally blocked today by the Helius plan
# quota — every RPC method returns `429 max usage reached`.
FEATURE_CURVE_COLLECTION_ENABLED=false
CURVE_COLLECTION_BATCH_LIMIT=100

# --- Development conveniences ------------------------------------------------
# Skip authentication entirely: every request is treated as an authenticated
# developer and the sign-in pages are routed past. No auth code is removed —
# set both back to false to restore the normal flow.
#
# LOCAL DEVELOPMENT ONLY. The backend raises on startup if this is set while
# ENVIRONMENT=production, and the frontend ignores it in a production build.
DEVELOPMENT_BYPASS_AUTH=false
NEXT_PUBLIC_DEVELOPMENT_BYPASS_AUTH=false

# --- Strategy Lab (research only; no capital execution) ---
# DISABLED | BACKTEST | FORWARD_RESEARCH. There is deliberately no live value:
# Strategy Lab has no signer and no transaction path.
STRATEGY_LAB_MODE=DISABLED
# Simulated research capital per strategy. Never real, never a balance.
STRATEGY_LAB_STARTING_CAPITAL=1000
STRATEGY_LAB_TICK_SECONDS=300
