# MEMESCOPE production edge.
#
# Caddy rather than nginx because the objective is a *permanent* HTTPS URL:
# Caddy provisions and renews certificates from Let's Encrypt on its own, while
# the nginx config this supersedes (docker/nginx/nginx.conf) expects certificate
# files to already exist at docker/nginx/certs and has no renewal story. A
# certificate that silently expires ninety days after an alpha launch is the
# most predictable outage this deployment could have.
#
# DOMAIN and ACME_EMAIL are supplied by the environment; Caddy fails to start if
# DOMAIN is unset, which is the correct behaviour - a reverse proxy that comes up
# on the wrong hostname would serve the alpha to nobody and get a certificate for
# nothing.
{
	email {$ACME_EMAIL}
	# Cuts the noisy per-request lines while keeping errors.
	log {
		level WARN
	}
}

{$DOMAIN} {
	encode zstd gzip

	# --- Security headers --------------------------------------------------
	#
	# These are the *edge* copy. The API sets its own (see
	# app/middleware/security_headers.py) and those win for API responses
	# because `header` here only adds what is missing. The duplication is
	# deliberate: the frontend is a Next.js server that sets none of these, so
	# without them here the HTML responses would ship bare.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Caddy advertises itself by default; there is no reason to tell a
		# scanner which server and version it is talking to.
		-Server
	}

	# --- Media -------------------------------------------------------------
	#
	# The site soundtrack, served straight off the host. Three reasons it is
	# here rather than in the frontend bundle or behind the API:
	#
	#   * It is a commercial recording and the repository is public. A file in
	#     `frontend/public` is a file anyone can download from GitHub. This one
	#     lives in `media/` on the host, which is gitignored.
	#   * The API sits behind the alpha gate and answers 401 to anyone who has
	#     not unlocked it. The music button is on the landing page, which is
	#     exactly where nobody has unlocked anything yet. Caddy answers first.
	#   * Images are rebuilt on every deploy, so a file copied into a container
	#     would vanish on the next one. A bind mount survives them all.
	#
	# `handle_path` strips `/media` before the lookup; `file_server` answers the
	# range requests an <audio> element makes as it seeks and buffers.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# --- API ---------------------------------------------------------------
	#
	# WebSockets need no special directive in Caddy v2 - reverse_proxy upgrades
	# the connection automatically - but the long-lived stream needs its read
	# timeout lifted, or the token feed is severed every 30 seconds.
	#
	# Inside `handle` so the media block above can claim its paths first:
	# `handle` blocks are mutually exclusive, and one with no matcher is the
	# fallback for everything the others did not take.
	handle {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_timeout 3600s
			}
		}
	}
}
